#: includes/lib/welcome.php:189
msgid "What's New"
msgstr "Neuigkeiten"

#: includes/lib/welcome.php:191
msgid "Changelog"
msgstr "Änderungsprotokoll"

#: includes/lib/welcome.php:192
msgid "Privacy"
