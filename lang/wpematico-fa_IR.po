msgstr "غیرفعال &mdash; اکنون بخشی از WPeMatico"

#: includes/addons_page.php:337
msgid "WPeMatico Add-Ons Plugins"
msgstr "افزودنی‌های WPeMatico"

#: includes/addons_page.php:364 includes/addons_page.php:366
msgid "Search Add-Ons"
msgstr "جستجوی افزودنی‌ها"

#: includes/addons_page.php:365
msgid "Add-on name, feature…"
msgstr "نام افزودنی، قابلیت…"

