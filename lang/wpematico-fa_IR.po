msgid "Showing %1$s of %2$s."
msgstr "نمایش %1$s از %2$s."

#: includes/addons_page.php:425
msgid "No add-ons match your search."
msgstr "هیچ افزودنی‌ای با جستجوی شما همخوان نیست."

#: includes/addons_page.php:491
msgid "Icon"
msgstr "نماد"

#: includes/addons_page.php:492
msgid "Add On"
msgstr "افزودنی"

#: includes/addons_page.php:493 includes/campaign-types/vimeo.php:369
msgid "Description"
msgstr "توضیح"

#: includes/addons_page.php:494
msgid "Adquire"
msgstr "تهیه"

#: includes/addons_page.php:573
msgid "Install %s from WordPress.org, free"
msgstr "نصب رایگان %s از WordPress.org"

#: includes/addons_page.php:575
msgid "Install now"
msgstr "هم‌اکنون نصب کنید"

#: includes/addons_page.php:583
msgid "See Plugins"
msgstr "دیدن افزونه‌ها"

#: includes/addons_page.php:584
msgid "See plugins in membership at etruel's store"
msgstr "دیدن افزونه‌های این عضویت در فروشگاه etruel"

#: includes/addons_page.php:587
msgid "Purchase"
msgstr "خرید"

#: includes/addons_page.php:588
msgid "Go to purchase on the etruel's store"
msgstr "خرید از فروشگاه etruel"

