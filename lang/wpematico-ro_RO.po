msgid "Highlights of the new release"
msgstr "Cele mai importante din noua versiune"

#: includes/settings/page.php:1035 includes/lib/licenses_handlers.php:405
msgid "Version"
msgstr "Versiune"

#: includes/settings/page.php:1047
