msgid "Pause after every post, in seconds:"
msgstr "每篇文章之后暂停的秒数："

#: includes/settings/page.php:49
msgid "Processing successful"
msgstr "处理成功"

#: includes/settings/page.php:557
msgid "Cron and Scheduler Settings"
msgstr "Cron 与调度设置"

#: includes/settings/page.php:587
msgid "Set up a cron job that calls:"
msgstr "设置一个 cron 任务调用："

#: includes/settings/page.php:592
msgid "URL:"
msgstr "网址："

#: includes/settings/page.php:613
msgid "Click to use this random code."
msgstr "点击即可使用这个随机代码。"

#: includes/settings/page.php:614
msgid "Any text you like."
msgstr "任意文字。"

#: includes/settings/page.php:634
msgid "To run the WordPress cron from outside, set up a cron job that calls:"
