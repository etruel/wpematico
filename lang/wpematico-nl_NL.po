msgstr ""
"Bulkbewerking wijzigt de hoofdvelden van alle campagnes die je selecteert in "
"één keer."

#: includes/campaigns_list_help.php:97
msgid "\"Send to Trash\" removes all the selected campaigns in one go."
msgstr "„Naar prullenbak” haalt alle geselecteerde campagnes in één keer weg."

