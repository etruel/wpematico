#: includes/campaign_edit.php:127
msgid "Type the new feed addresses."
msgstr "Escribe las nuevas direcciones de feed."

#: includes/campaign_edit.php:128 includes/campaigns_list.php:315
msgid "Running Campaign..."
msgstr "Ejecutando campañas..."

#: includes/campaign_edit.php:129
msgid "Save the campaign before running it"
msgstr "Guarda la campaña antes de ejecutarla"

#: includes/campaign_edit.php:130
msgid "Save the campaign before this action"
msgstr "Guarda la campaña antes de esta acción"

#: includes/campaign_edit.php:131
msgid "Are you sure you want to reset this campaign?"
msgstr "¿Seguro que quieres reiniciar esta campaña?"

#: includes/campaign_edit.php:132
msgid ""
"Are you sure you want to delete hash code for duplicates of this campaign?"
msgstr "¿Seguro que quieres borrar el hash de duplicados de esta campaña?"

#: includes/campaign_edit.php:134
msgid ""
"An error has occurred, this could be because the web server does not have "
"all the requirements of WPeMatico please check your <a href=\"%s\">System "
"Status</a>, if everything is ok try again."
msgstr ""
"Se ha producido un error, esto podría deberse a que el servidor web no tiene "
"todos los requisitos de WPeMatico por favor revise su <a href=\"%s\">Estado "
"del Sistema</a>, si todo está bien, inténtalo nuevamente."

#: includes/campaign_edit.php:135
msgid "Wizard"
