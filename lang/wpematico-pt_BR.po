msgstr "Exportar/importar campanhas"

#: includes/module/actions.php:690
msgid "Migrate campaigns between sites."
msgstr "Migre campanhas entre sites."

#: includes/module/actions.php:700
msgid "Feed Creator"
msgstr "Feed Creator"

