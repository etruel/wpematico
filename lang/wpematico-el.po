msgstr "Δείτε λεπτομέρειες και τιμές στο κατάστημα του etruel"

#: includes/addons_page.php:762 includes/module/actions.php:305
#: includes/module/dashboard.php:55 includes/module/manager.php:130
#: includes/module/manager.php:151 includes/module/manager.php:156
msgid "Installed"
msgstr "Εγκατεστημένο"

#: includes/addons_page.php:780
msgid "Add license"
msgstr "Προσθήκη άδειας"

#: includes/addons_page.php:781
msgid "Renew license"
msgstr "Ανανέωση άδειας"

#: includes/addons_page.php:782 includes/addons_page.php:790
msgid "Activate license"
msgstr "Ενεργοποίηση άδειας"

#: includes/addons_page.php:783
msgid "Check license"
msgstr "Έλεγχος άδειας"

#: includes/addons_page.php:788
