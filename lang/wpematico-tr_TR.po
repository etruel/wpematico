"%1$s lisansının süresi %2$s tarihinde doldu. Güncelleme ve destek almayı "
"sürdürmek için yenileyin."

#: includes/lib/update_reasons.php:148
msgid ""
"The license of %s expired. Renew it to keep receiving updates and support."
msgstr ""
"%s lisansının süresi doldu. Güncelleme ve destek almayı sürdürmek için "
"yenileyin."

#: includes/lib/update_reasons.php:150
msgid "Renew your license"
msgstr "Lisansınızı yenileyin"

